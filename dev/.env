# =============================================================================
# Development env for the stashbox stack.
#
# Consumed by BOTH:
#   1. dev/docker-compose.yaml  (docker compose auto-loads this file)
#   2. stashbox-api running in IntelliJ  (point the EnvFile / "Environment
#      variables from file" setting of the run configuration at this file)
#
# Everything is a literal value - no ${...} interpolation - so the IntelliJ
# EnvFile plugin (which does not expand references) reads it correctly.
#
# Host <-> container reachability for the IntelliJ-run API:
#   - Keycloak  -> http://localhost:9090   (published by the keycloak service)
#   - Postgres  -> localhost:5432          (published by postgres-stashbox)
#   - Nginx     -> http://localhost:8081   (published by the nginx service)
# The compose file hardcodes the in-network URLs (http://keycloak:8080) for its
# own one-shot containers, so KEYCLOAK_INTERNAL_URL below is the host value.
# =============================================================================

# --- Hostnames / URLs ------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

KEYCLOAK_PORT=9090
# Browser-facing Keycloak URL == token issuer. Used by compose (KC_HOSTNAME)
# and by the API (spring...jwt.issuer-uri / KEYCLOAK_PUBLIC_URL).
KEYCLOAK_PUBLIC_URL=http://localhost:9090
# How the IntelliJ-run API reaches Keycloak (JWKS, token endpoint).
KEYCLOAK_INTERNAL_URL=http://localhost:9090
KEYCLOAK_SSL_REQUIRED=none

# --- Keycloak realm / backend client -------------------------------------
KEYCLOAK_REALM=stashbox
KEYCLOAK_CLIENT_ID=stashbox-backend
KEYCLOAK_CLIENT_SECRET=dev-backend-client-secret-change-me
# Same value, name expected by the compose one-shot containers.
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-backend-client-secret-change-me
KEYCLOAK_WEBHOOK_HMAC_SECRET=dev-webhook-hmac-secret-change-me

# --- Keycloak Database ---------------------------------------------------
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-dev

# --- Keycloak Master Admin Bootstrap -----------------------------------
KEYCLOAK_MASTER_ADMIN_USER=admin
KEYCLOAK_MASTER_ADMIN_PASSWORD=admin

# --- Keycloak Admin for the Stashbox Realm ----------------------------
APP_ADMIN_USER=stashbox-admin
APP_ADMIN_EMAIL=stashbox-admin@example.com
APP_ADMIN_PASSWORD=stashbox-admin-dev

# --- Stashbox Database -------------------------------------------------
# The API (on the host) connects over the published port.
STASHBOX_DB_PORT=5432
STASHBOX_DB_URL=jdbc:postgresql://localhost:5432/stashbox
STASHBOX_DB_USER=stashbox
STASHBOX_DB_PASSWORD=stashbox-dev

# --- Nginx (image/file server) ---------------------------------------
NGINX_PORT=8081

# --- App Configuration ---------------------------------------------------
PUBLIC_ENDPOINTS=/webhooks/keycloak,/actuator/health
IMAGE_OUTPUT_MAX_SIZE=2500
IMAGE_OUTPUT_QUALITY=90
# Overrides app.storage.base-path (/stashbox) from application.yaml so the
# host-run API writes into the same directory the nginx service serves
# (dev/volumes/stashbox-app, mounted read-only at /storage in nginx).
APP_STORAGE_BASE_PATH=e:/Projects/fullstack/stashbox-api/dev/volumes/stashbox-app
